# ── required ──
BOT_TOKEN=123456:ABC-from-BotFather

# ── website (token sale + tools API). Default is already your site ──
SITE_URL=https://amertakcloud.vercel.app

# ── Audio → .srt uses Gemini directly (get a key at https://aistudio.google.com/apikey) ──
GEMINI_API_KEY=
# GEMINI_SRT_MODEL=gemini-3.8-flash
# SRT_DAILY_LIMIT=5

# ── webhook (Render sets RENDER_EXTERNAL_URL for you; nothing to do) ──
# WEBHOOK_SECRET=any-long-random-string      # recommended; generated automatically if empty
# USE_POLLING=true                           # local development only
# PORT=3000                                  # Render sets this
